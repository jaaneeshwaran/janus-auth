# Janus-Auth configuration example.
# Copy to .env and fill in real values. Never commit a real signing secret.

# Required outside local testing. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
JANUS_SIGNING_SECRET=change-me

# Optional. If unset, the trace store generates an ephemeral key and warns.
JANUS_TRACE_ENCRYPTION_KEY=

# Optional tuning.
JANUS_RETENTION_DAYS=7
JANUS_Z3_TIMEOUT_MS=5000
JANUS_MAX_REQUESTS=500